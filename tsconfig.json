{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "mocha"]
  },
  "include": ["src", "test"],
  "exclude": ["src/compare/webview"]
}
