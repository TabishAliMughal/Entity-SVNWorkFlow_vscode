# dependencies and build output
node_modules/
dist/
out/
.vscode-test/
coverage/
*.vsix
*.tsbuildinfo

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# secrets / local env
.env
.env.*

# OS / editor junk
Thumbs.db
.DS_Store
desktop.ini
*.swp
*.swo
*~
.idea/

# VS Code: keep launch.json / tasks.json / extensions.json, ignore the rest
.history
.vscode
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# local test environment artifacts (envctl.py, conf/ templates stay tracked)
__pycache__/
*.pyc
test-env/data/
test-env/repos/
test-env/wc*/
test-env/run/
test-env/apache/
test-env/*.pid

# local-only documentation: no docs and no markdown on GitHub except README.md
docs/
*.md
!/README.md
